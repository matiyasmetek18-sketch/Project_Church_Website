---
import { churchConfig } from '../config/church';
---

<header class="w-full border-b border-warm-border bg-warm-white sticky top-0 z-40 transition-all">
  <!-- Top Plant Status Notice Bar -->
  <div class="bg-navy-950 text-slate-300 text-xs py-2 px-4 border-b border-navy-800">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1 text-center sm:text-left">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-gold-500 animate-pulse" aria-hidden="true"></span>
        <span class="font-medium tracking-wide uppercase text-[11px] text-gold-400">Church Plant Notice</span>
        <span class="hidden sm:inline text-slate-500" aria-hidden="true">|</span>
        <span class="text-slate-300">Phase 1 preview with verified placeholders for leadership review</span>
      </div>
      <div class="text-[11px] text-slate-400 tracking-wider uppercase font-semibold">
        {churchConfig.tradition} Tradition
      </div>
    </div>
  </div>

  <!-- Primary Navigation Bar -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand & Name -->
      <a href="/" class="group flex flex-col focus:outline-none focus:ring-2 focus:ring-gold-600 focus:ring-offset-2 rounded px-1 -ml-1">
        <div class="flex items-center gap-2">
          <!-- Monogram / Cross Icon Placeholder -->
          <span class="w-8 h-8 rounded border border-navy-800/30 flex items-center justify-center font-display font-semibold text-navy-900 group-hover:border-gold-600 group-hover:text-gold-700 transition-colors bg-warm-cream" aria-hidden="true">
            ✝
          </span>
          <span class="font-display text-xl sm:text-2xl font-bold tracking-tight text-navy-950 group-hover:text-gold-700 transition-colors">
            {churchConfig.name}
          </span>
        </div>
        <span class="text-[11px] tracking-widest uppercase font-semibold text-navy-600 pl-10 -mt-1">
          {churchConfig.tradition} Plant
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2" aria-label="Main Navigation">
        {churchConfig.navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-navy-800 hover:text-gold-700 hover:bg-warm-cream rounded transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Action Button (Desktop) -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="#gathering" 
          class="inline-flex items-center justify-center px-4 py-2 border border-navy-900 text-sm font-semibold text-warm-white bg-navy-900 hover:bg-navy-800 hover:border-navy-800 active:scale-[0.99] rounded transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-gold-600 focus:ring-offset-2"
        >
          Plan a Visit
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-btn"
          type="button" 
          class="inline-flex items-center justify-center p-2 rounded-md text-navy-900 hover:text-gold-700 hover:bg-warm-cream focus:outline-none focus:ring-2 focus:ring-gold-600"
          aria-controls="mobile-menu" 
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <!-- Hamburger Icon -->
          <svg id="hamburger-icon" class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close Icon -->
          <svg id="close-icon" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-warm-border bg-warm-white px-4 pt-3 pb-6 space-y-2">
    {churchConfig.navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-navy-900 hover:bg-warm-cream hover:text-gold-700"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2">
      <a 
        href="#gathering" 
        class="mobile-nav-link w-full flex items-center justify-center px-4 py-3 rounded border border-navy-900 bg-navy-900 text-warm-white font-semibold text-center text-sm shadow-sm"
      >
        Plan a Visit
      </a>
    </div>
  </div>
</header>

<script>
  const headerEl = document.querySelector('header');
  if (headerEl) {
    const syncScrollPadding = () => {
      document.documentElement.style.scrollPaddingTop = `${headerEl.offsetHeight}px`;
    };
    syncScrollPadding();
    new ResizeObserver(syncScrollPadding).observe(headerEl);
  }

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && hamburger && closeIcon) {
    const setMenuOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      hamburger.classList.toggle('hidden', open);
      closeIcon.classList.toggle('hidden', !open);
    };

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isExpanded);
    });

    // Close menu when a link is tapped
    links.forEach((link) => {
      link.addEventListener('click', () => {
        if (btn.getAttribute('aria-expanded') === 'true') {
          setMenuOpen(false);
        }
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || btn.getAttribute('aria-expanded') !== 'true') {
        return;
      }
      event.preventDefault();
      setMenuOpen(false);
      btn.focus();
    });

    // Desktop nav is always visible at md; don't leave the mobile menu expanded.
    const desktopNav = window.matchMedia('(min-width: 768px)');
    const resetMenuAtDesktop = () => {
      if (desktopNav.matches) {
        setMenuOpen(false);
      }
    };
    desktopNav.addEventListener('change', resetMenuAtDesktop);
  }
</script>
